# Required: Alibaba Cloud DashScope API Key
# Get yours at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx

# API base URL (OpenAI compatible endpoint)
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# LLM model for summarization (default: qwen3.5-plus)
DASHSCOPE_MODEL=qwen3.5-plus

# Whisper model size (default: medium)
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=medium

# Whisper compute type (default: int8)
# Options: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# Max video duration in seconds (default: 14400 = 4 hours)
MAX_VIDEO_DURATION=14400

# Cookies file for platforms like Douyin (Netscape format)
# Default: checks for cookies.txt in project root
# COOKIES_FILE=cookies.txt
